{
  "name": "japanese-learning-site",
  "private": true,
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r --if-present build",
    "lint": "oxlint",
    "typecheck": "oxlint --type-aware --type-check",
    "test": "pnpm -r --if-present test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "db:up": "docker compose up -d db",
    "db:generate": "pnpm --filter api exec prisma generate",
    "db:migrate": "pnpm --filter api exec prisma migrate dev",
    "db:seed": "pnpm --filter api exec tsx prisma/seed.ts"
  },
  "devDependencies": {
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1"
}
